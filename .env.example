# Vibe 1099 appliance environment
# Copy to .env and fill in. All values validated at boot (fail-fast).

NODE_ENV=production

# --- Postgres ---
DATABASE_URL=postgres://vibe1099:vibe1099@postgres:5432/vibe1099

# --- Redis (dedicated DB index per suite Redis sharing policy) ---
REDIS_URL=redis://redis:6379/3

# --- Ports (suite port table: api 8210, web 8211, render 8212) ---
API_PORT=8210

# --- Secrets ---
# 32 bytes base64. Master key for envelope encryption (TINs, JWKs), HMAC tin_hash,
# and token signing (separate keys derived via HKDF). Provisioned by appliance secret store.
MASTER_KEY=CHANGE_ME_BASE64_32_BYTES

# --- URLs ---
# Staff/client app base (LAN / Tailscale)
APP_BASE_URL=http://localhost:8211
# Public portal base (recipient + W-9 routes, Cloudflare Tunnel)
PORTAL_BASE_URL=http://localhost:8211

# --- Render sidecar ---
RENDER_URL=http://render:8212

# --- Licensing ---
# 0 = license activation not enforced (licensing.kisaes.com later-phase)
LICENSE_REQUIRED=0
LICENSE_SERVER_URL=https://licensing.kisaes.com

# --- Email delivery (auto = SMTP if SMTP_HOST set, else EmailIt if key set, else none) ---
EMAIL_PROVIDER=auto

# --- SMTP (firm relay) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vibe 1099 <no-reply@example.com>"
# 1 = implicit TLS (port 465). STARTTLS is negotiated when available; set your
# relay to require TLS so portal-link emails never transit in cleartext.
SMTP_SECURE=0

# --- EmailIt (hosted ESP, alternative to SMTP) ---
EMAILIT_API_KEY=
EMAILIT_FROM=

# --- SMS (provider-agnostic adapter: textlink | twilio | none) ---
# TextLink is the shipped default; falls back to no-op until an API key exists.
# Firm-level credentials can also be set in the app: Settings -> SMS provider
# (stored envelope-encrypted; overrides these env values).
SMS_PROVIDER=textlink
TEXTLINK_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- IRIS ---
# ATS and production endpoint bases; firm-level TCC/ClientID/JWK live in Settings (DB, encrypted)
IRIS_ATS_BASE_URL=https://la.alt.www4.irs.gov/iris
IRIS_PROD_BASE_URL=https://la.www4.irs.gov/iris
# Point at the bundled mock for integration testing.
# WARNING: MUST be empty in production — a mock base URL makes returns look
# "accepted" without ever filing them with the IRS. Boot refuses it when NODE_ENV=production.
IRIS_MOCK_BASE_URL=

# --- Tax1099 (Zenwork) managed-filing backend (used when a firm/payer selects provider 'tax1099') ---
TAX1099_SANDBOX_BASE_URL=https://api.sandbox.tax1099.com
TAX1099_PROD_BASE_URL=https://api.tax1099.com
# WARNING: MUST be empty in production (same silent-misfile risk as IRIS_MOCK_BASE_URL).
TAX1099_MOCK_BASE_URL=

# --- TaxBandits (SPAN Enterprises) managed-filing backend (optional contingency) ---
# Off unless enabled here AND per-firm in Settings. Used e.g. while an IRS TCC is pending.
TAXBANDITS_ENABLED=0
TAXBANDITS_SANDBOX_BASE_URL=https://testapi.taxbandits.com
TAXBANDITS_PROD_BASE_URL=https://api.taxbandits.com
# WARNING: MUST be empty in production (same silent-misfile risk).
TAXBANDITS_MOCK_BASE_URL=
# Documented TaxBandits webhook source IPs (comma-separated; update via config, not code).
TAXBANDITS_WEBHOOK_IPS=34.239.209.88,129.213.79.42,34.194.208.36
# Shared secret the webhook must present (x-taxbandits-signature header). Fail-closed if empty.
TAXBANDITS_WEBHOOK_SECRET=

# --- Ops ---
LOG_LEVEL=info
# Trusted reverse-proxy hops in front of the API. Cloudflare Tunnel + Caddy = 2.
# Wrong values break per-IP rate limiting (set to your real topology; 0 if the
# API is directly exposed with no proxy).
TRUST_PROXY_HOPS=2
SESSION_INACTIVITY_MINUTES=30
# Absolute session lifetime cap (hours), independent of activity.
SESSION_ABSOLUTE_HOURS=12

# --- Public access (Cloudflare Tunnel) ---
# The tunnel TOKEN is managed in-app (Settings → Public access), stored encrypted,
# and written to a shared volume the cloudflared sidecar runs with. These two only
# need overriding if you change the sidecar service name/port or token path.
# CLOUDFLARE_METRICS_URL=http://cloudflared:2000
# CLOUDFLARE_TOKEN_FILE=/shared/cloudflared/token
# After setting/changing the token: docker compose restart cloudflared
# Set these to your public https hostname once the tunnel is up:
# APP_BASE_URL=https://1099.yourfirm.com
# PORTAL_BASE_URL=https://1099.yourfirm.com
STAFF_IP_ALLOWLIST=
DATA_RETENTION_YEARS=4
