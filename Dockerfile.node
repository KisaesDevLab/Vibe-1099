# syntax=docker/dockerfile:1
# check=skip=SecretsUsedInArgOrEnv
# Vibe 1099 — shared image for api + worker (Node 24, tsx runtime)
FROM node:24-slim AS base
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY packages/shared/package.json packages/shared/
COPY packages/db/package.json packages/db/
COPY packages/core/package.json packages/core/
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
# @kisaesdevlab/vibe-auth (single sign-on) comes from GitHub Packages. The token
# arrives as a BuildKit secret and is written to a throwaway npmrc that never
# lands in a layer:  docker build --secret id=NODE_AUTH_TOKEN,env=NODE_AUTH_TOKEN …
RUN --mount=type=secret,id=NODE_AUTH_TOKEN,required=true \
    printf '//npm.pkg.github.com/:_authToken=%s\n' "$(cat /run/secrets/NODE_AUTH_TOKEN)" > /root/.npmrc \
 && pnpm install --frozen-lockfile --filter '!@vibe1099/web' \
 && rm -f /root/.npmrc

COPY tsconfig.base.json tsconfig.json ./
COPY packages/ packages/
COPY apps/api/ apps/api/
COPY apps/worker/ apps/worker/

EXPOSE 8210
# Vibe Auth break-glass CLI adapter (a module path, not a secret). The appliance
# console runs, from WORKDIR /app:
#   node --import tsx apps/api/node_modules/@kisaesdevlab/vibe-auth/dist/cli.js breakglass ensure --json
ENV VIBE_AUTH_ADAPTER=/app/apps/api/src/vibeAuthAdapter.ts
# Drop root: run as the image's built-in unprivileged `node` user so a code-exec
# bug in api/worker doesn't run as UID 0 (least privilege — Pub 4557).
RUN chown -R node:node /app
USER node
# api by default; worker overrides command in compose
CMD ["pnpm", "--filter", "@vibe1099/api", "start"]
